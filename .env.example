# Copy this file to .env and set the values your agent uses.

# OpenRouter credentials and model
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=inclusionai/ling-2.6-1t:free

# The default base URL is https://openrouter.ai/api/v1.
# Another host selects the OpenAI chat-completions dialect.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# The default turn limit is 25. Set 0 for unlimited turns.
OPENROUTER_MAX_TURNS=25

# Search
# searchWeb uses Tavily when this key is set and DuckDuckGo otherwise.
TAVILY_API_KEY=tvly-your-key-here

# Logging
DEBUG=false

# Sampling and generation
# OPENROUTER_TEMPERATURE=1.0
# OPENROUTER_TOP_P=1.0
# OPENROUTER_MIN_P=0
# OPENROUTER_TOP_K=0
# OPENROUTER_FREQUENCY_PENALTY=0
# OPENROUTER_PRESENCE_PENALTY=0
# OPENROUTER_REPETITION_PENALTY=1.0
# OPENROUTER_SEED=
# OPENROUTER_MAX_COMPLETION_TOKENS=

# Reasoning
# OPENROUTER_REASONING_EFFORT=high
# OPENROUTER_REASONING_MAX_TOKENS=
# OPENROUTER_REASONING_EXCLUDE=false
# OPENROUTER_REASONING_ENABLED=true

# Provider routing
# OPENROUTER_ORDER=OpenRouter,Google,Anthropic
# OPENROUTER_ONLY=Google
# OPENROUTER_PROVIDER_IGNORE=ProviderA,ProviderB
# OPENROUTER_PROVIDER_AVOID=ProviderA,ProviderB
# OPENROUTER_PROVIDER_SORT=price
# OPENROUTER_PROVIDER_ALLOW_FALLBACKS=true
# OPENROUTER_PROVIDER_REQUIRE_PARAMETERS=false
# OPENROUTER_PROVIDER_DATA_COLLECTION=allow

# Memory
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Runtime behavior
# OPENROUTER_AUTO_WAKE=false
# OPENROUTER_EMPTY_TURN_RECOVERY=true
# OPENROUTER_EMPTY_TURN_RETRIES=2

# Storage namespace for .<appName>/memory, todos, sessions, and temporary logs.
# The default is agent-sdk.
# AGENT_SDK_APP_NAME=agent-sdk
